# Copy this file to .env and fill in the real values:  cp .env.example .env
# .env is git-ignored - never commit real credentials.
# Anything left unset falls back to the default in application.properties.

# --- Database (password is required) ---
DB_URL=jdbc:postgresql://<host>:5432/<database>
DB_USERNAME=postgres
DB_PASSWORD=

# --- Mail / Gmail app password (password is required) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Optional overrides (defaults shown) ---
#APP_NAME=final_project
#SERVER_PORT=8080
#APP_TIMEZONE=Asia/Phnom_Penh
#MAIL_ENCODING=UTF-8
#MAIL_SMTP_AUTH=true
#MAIL_SMTP_STARTTLS=true
#MAIL_MIME_CHARSET=UTF
#MULTIPART_ENABLED=true
#MULTIPART_FILE_SIZE_THRESHOLD=2KB
#MULTIPART_MAX_FILE_SIZE=20MB
#MULTIPART_MAX_REQUEST_SIZE=50MB
